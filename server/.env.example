# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Placeholder - fill with your MongoDB connection string in .env)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/civicreflex?retryWrites=true&w=majority

# Client Application URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
ACCESS_TTL=15m
REFRESH_TTL=7d

